# Copy to backend/.env and fill in. backend/.env is gitignored; never commit
# real keys. Backend-only names: never prefix these with NEXT_ or NEXT_PUBLIC_.

# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# Publishable (anon) key: verifies user access tokens.
SUPABASE_PUBLISHABLE_KEY=

# Secret (service-role) key: bypasses row-level security. Server only.
SUPABASE_SECRET_KEY=
